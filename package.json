{
  "name": "golden-raccoon",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "start": "npm --prefix frontend run start",
    "deploy:check": "node scripts/check-deploy-readiness.mjs",
    "test:agents": "npm --prefix frontend run test:agents",
    "test:auto-mode": "npm --prefix frontend run test:auto-mode",
    "test:stellar-config": "npm --prefix frontend run test:stellar-config",
    "test:recovery": "npm --prefix frontend run test:recovery",
    "test:stellar-rpc": "node scripts/check-stellar-rpc.mjs",
    "test:a11y": "npm --prefix frontend run test:a11y",
    "smoke": "node scripts/smoke-api.mjs",
    "monitor:production": "node scripts/monitor-production.mjs",
    "quality:gate": "npm run deploy:check && npm run test:stellar-config && npm run test:auto-mode && npm run test:agents && npm run test:a11y && npm run lint && npm run build",
    "quality:gate:full": "npm run quality:gate && npm run smoke",
    "verify": "npm run quality:gate",
    "acceptance": "node scripts/acceptance-matrix.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "supply-chain:policy": "node scripts/verify-dependency-policy.mjs",
    "supply-chain:policy:audit": "node scripts/verify-dependency-policy.mjs --audit",
    "provenance:verify": "node scripts/verify-build-provenance.mjs verify all"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
